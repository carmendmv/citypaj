# Configuracion general de CityPAJ para Docker local
NODE_ENV=development
PORT=3001

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=citypaj
DB_USER=citypaj_user
DB_PASSWORD=citypaj_password

# Backend
BACKEND_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3002/api
NEXT_PUBLIC_APP_URL=http://localhost:3001

# JWT (seguro unicamente para demo)
JWT_SECRET=citypaj_secret_demo
JWT_REFRESH_SECRET=citypaj_refresh_demo

# CORS
CORS_ORIGINS=http://localhost:3001

# Usuarios demo
DEMO_ADMIN_EMAIL=admin@citypaj.local
DEMO_ADMIN_PASSWORD=Test1234!
DEMO_MODERATOR_EMAIL=moderador@citypaj.local
DEMO_MODERATOR_PASSWORD=Test1234!
DEMO_USUARIO_EMAIL=usuario@citypaj.local
DEMO_USUARIO_PASSWORD=Test1234!
