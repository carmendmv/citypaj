# Configuración General
NODE_ENV=development
PORT=3001

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=citypaj
DB_USER=postgres
DB_PASSWORD=citypaj123
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=citypaj123
REDIS_DB=0
REDIS_KEY_PREFIX=citypaj:
REDIS_TTL_SESSION=86400
REDIS_TTL_CACHE=3600
REDIS_TTL_RATE_LIMIT=900

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=citypaj
JWT_AUDIENCE=citypaj-users

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@citypaj.es

# Upload de Archivos
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_FILES=6
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
S3_BUCKET=citypaj-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=5
RATE_LIMIT_UPLOAD=10

# Moderación
MODERATION_AUTO_APPROVE=false
MODERATION_ML_ENDPOINT=
MODERATION_ML_API_KEY=
MODERATION_TOXICITY_THRESHOLD=0.7

# Features
FEATURE_EMAIL_VERIFICATION=true
FEATURE_PHONE_VERIFICATION=false
FEATURE_SOCIAL_LOGIN=false
FEATURE_NOTIFICATIONS=true
FEATURE_ANALYTICS=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Seguridad
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-in-production
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
