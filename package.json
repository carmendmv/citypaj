{
  "name": "citypaj",
  "version": "1.0.0",
  "description": "Plataforma de voluntariado y servicios juveniles",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:real": "cd backend && npm run server:real",
    "build": "cd backend && npm run build && cd ../frontend && npm run build",
    "start": "cd backend && npm run start",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "test": "cd backend && npm test && cd ../frontend && npm test",
    "db:check": "cd backend && npm run db:check",
    "db:verify": "cd backend && npm run db:verify",
    "db:load-real": "cd backend && npm run db:load-real",
    "db:expand-categories": "cd backend && npm run db:expand-categories",
    "test:connection": "cd backend && npm run test:connection",
    "test:real-connection": "cd backend && npm run test:real-connection",
    "diagnose:mysql": "cd backend && npm run diagnose:mysql"
  },
  "keywords": [
    "voluntariado",
    "juvenil",
    "servicios",
    "comunidad"
  ],
  "author": "CityPaj Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "uuid": "^14.0.0"
  }
}
