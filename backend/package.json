{
  "name": "citypaj-backend",
  "version": "1.0.0",
  "description": "Backend API de CityPaj - Plataforma de anuncios juvenil",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --ext ts,js,json --exec ts-node --project tsconfig.dev.json src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "db:init": "node scripts/init-db.js",
    "db:check": "node check-db.js",
    "db:verify": "node verify-db.js",
    "db:seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.0",
    "compression": "^1.7.0",
    "cors": "^2.8.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "knex": "^3.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.0",
    "mysql2": "^3.22.4",
    "nodemailer": "^6.9.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "sharp": "^0.32.0",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.0",
    "@types/compression": "^1.7.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^20.8.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.10.0",
    "@types/supertest": "^2.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
