# Servidor
PORT=3002
NODE_ENV=development

# MySQL (Docker)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=citypaj
DB_USER=citypaj_user
DB_PASSWORD=citypaj_password

# JWT (cambiar por secretos largos y aleatorios en producción)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Seguridad
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000
PASSWORD_RESET_TOKEN_MINUTES=30

# Características
FEATURE_EMAIL_VERIFICATION=true

# Usuarios demo (solo para desarrollo local; configurar contraseñas seguras)
DEMO_ADMIN_EMAIL=admin@citypaj.local
DEMO_ADMIN_PASSWORD=
DEMO_MODERATOR_EMAIL=moderador@citypaj.local
DEMO_MODERATOR_PASSWORD=
DEMO_USUARIO_EMAIL=usuario@citypaj.local
DEMO_USUARIO_PASSWORD=
