# CityPAJ - Configuración de Producción Segura
# =====================================
# Este archivo contiene todas las variables de entorno necesarias para producción
# CAMBIA LAS CONTRASEÑAS Y SECRETS ANTES DE USAR EN PRODUCCIÓN

# Entorno
NODE_ENV=production

# Configuración del Frontend Seguro
FRONTEND_PORT=3000
FRONTEND_HTTPS_PORT=3443

# Configuración del Backend Seguro
BACKEND_PORT=3002
BACKEND_HTTPS_PORT=3444

# Configuración de la Base de Datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=citypaj_user
DB_PASSWORD=citypaj_password
DB_NAME=citypaj
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000

# URLs de los servicios
FRONTEND_URL=https://localhost:3443
BACKEND_URL=https://localhost:3444
API_URL=https://localhost:3444

# Configuración de Seguridad - ¡CAMBIAR EN PRODUCCIÓN!
SSL_CERT_PATH=./certificates
SESSION_SECRET=citypaj-super-secret-session-key-change-this-in-production-2023
JWT_SECRET=citypaj-super-secret-jwt-key-change-this-in-production-2023
ENCRYPTION_KEY=citypaj-32-char-encryption-key-change-me

# Configuración de Monitoreo
HEALTH_CHECK_INTERVAL=30000
RECONNECT_DELAY=5000
MAX_RECONNECT_ATTEMPTS=5
MONITORING_ENABLED=true

# Configuración de Logs
LOG_LEVEL=info
LOG_FILE=./logs/citypaj.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD

# Configuración de Backups
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=./backups

# Configuración de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SUCCESS_MESSAGES=5
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# Configuración de CORS
CORS_ORIGIN=https://localhost:3443
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Configuración de Cookies
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=strict
COOKIE_MAX_AGE=86400000

# Configuración de Headers de Seguridad
HELMET_ENABLED=true
HELMET_CONTENT_SECURITY_POLICY=true
HELMET_CROSS_ORIGIN_EMBEDDER_POLICY=false
HELMET_CROSS_ORIGIN_OPENER_POLICY=false
HELMET_CROSS_ORIGIN_RESOURCE_POLICY=false
HELMET_DNS_PREFETCH_CONTROL=false
HELMET_EXPECT_CT=false
HELMET_FEATURE_POLICY=false
HELMET_FRAMEGUARD=true
HELMET_HIDE_POWERED_BY=true
HELMET_HSTS=true
HELMET_IE_NO_OPEN=false
HELMET_NO_SNIFF=true
HELMET_ORIGIN_AGENT_CLUSTER=false
HELMET_PERMITTED_CROSS_DOMAIN_POLICIES=false
HELMET_REFERRER_POLICY=true
HELMET_XSS_PROTECTION=true

# Configuración de Base de Datos de Producción
# Descomenta y configura para producción real
# DB_HOST=your-production-db-host
# DB_PORT=3306
# DB_USER=citypaj_prod_user
# DB_PASSWORD=your-secure-password
# DB_NAME=citypaj_prod_db

# Configuración de Redis para caché (opcional)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0

# Configuración de Email (opcional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@citypaj.es

# Configuración de Cloud Storage (opcional)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=citypaj-storage

# Configuración de Analytics (opcional)
# GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
# SENTRY_DSN=https://your-sentry-dsn

# Configuración de Desarrollo (solo para desarrollo local)
DEV_SSL_SELF_SIGNED=true
DEV_MOCK_DATA=false
DEV_VERBOSE_LOGGING=true
